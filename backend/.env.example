# Plantilla de configuración local del backend.
#   cp backend/.env.example backend/.env
# backend/.env está ignorado por Git: nunca subas credenciales reales al repositorio.
# Gradle carga backend/.env automáticamente para ./gradlew test y ./gradlew bootRun.

# ==== Compartido para desarrollo (datos sintéticos, no son secretos) ====
# Mismos valores para todo el equipo. No requieren re-ejecutar la semilla.
EDUFAST_DEMO_EMAIL_DOMAIN=example.test
EDUFAST_DEMO_PASSWORD=demo123
EDUFAST_DEMO_STUDENTS_PER_SECTION=10
EDUFAST_DEMO_SIBLING_PAIRS=10
EDUFAST_DEMO_SCHOOL_YEAR=2026
EDUFAST_DEMO_START_DATE=2026-03-16
EDUFAST_DEMO_END_DATE=2026-12-18

# ==== Privado: solicitar al equipo por un canal seguro; NO commitear ====
# El host y el usuario de Supabase de desarrollo ya son el default en
# application.properties. Aquí solo se define la contraseña (obligatoria) y,
# si quieres probar contra una BD distinta, el resto.
DB_PASSWORD=''
# Para apuntar a otra base (p. ej. Postgres local), descomenta y completa:
# DB_URL=''
# DB_USER=''
# URI de PostgreSQL para ejecutar supabase/seed.sql (Supabase -> Connect).
SUPABASE_DB_URL=''
# Clave para firmar tokens; genera una propia con: openssl rand -hex 32
JWT_SECRET=''

# Orígenes permitidos por CORS, separados por comas. Opcional: hay default de desarrollo.
# CORS_ALLOWED_ORIGINS='http://localhost:5173'
